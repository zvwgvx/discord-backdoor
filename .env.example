# Copy this file to .env and fill in the values

# Bot token (Developer Portal → Bot → Reset Token)
# ⚠️ If the token ever leaks, reset it in the Portal and paste the new one here
BOT_TOKEN=

# Discord user IDs allowed to issue "." commands (comma-separated)
# Everyone else gets silence — bot never responds to them
ALLOWED_USER_IDS=

# Server B - control server: "." commands only work here (required)
# "." commands from DMs or other servers are silently ignored
CONTROL_GUILD_ID=

# Server A - target server(s) (comma-separated)
# Every "." command typed in server B only acts on these servers - NOT server B
# (server B's ID placed here gets auto-removed at startup)
TARGET_GUILD_IDS=

# Default channel for ".purge <amount>" when no channelId is passed (must be in a target server)
DEFAULT_PURGE_CHANNEL_ID=

# Protected channel(s), comma-separated: OPTIONAL. When empty, the bot auto-
# detects log channels by name (dyno/carl/logs/audit/...) or by observing
# moderation-style log traffic (Dyno, Carl-bot, any other log bot). Ids listed
# here are forced on top of auto-detection. ONLY bot-performed actions' logs
# are deleted there
PROTECTED_CHANNEL_ID=

# Optional zero-exposure log gate: point Dyno at a PRIVATE staging channel; the
# bot reviews every entry there — matches are blocked forever, clean ones are
# relayed to the public log channel through the bot's webhook
LOG_STAGING_CHANNEL_ID=
# Where clean logs get re-posted (defaults to the first protected channel)
LOG_RELAY_CHANNEL_ID=
